@model List<SupplierSystem.Web.ViewModels.TeamMemberRow>
@{ ViewData["Title"] = "Team"; }
<div class="page-header">
    <div>
        <div class="crumbs">Workspace / <b>Team</b></div>
        <h1 class="page-title">Team</h1>
        <p class="page-sub">People who can sign in for your company. Staff can process orders but cannot change the catalog.</p>
    </div>
    <div class="page-actions"><a class="btn btn-primary" asp-action="Create">Add staff</a></div>
</div>
<section class="panel">
    <div class="table-wrap">
    <table class="table table-hover">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>State</th><th></th></tr></thead>
        <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td class="cell-title">@m.FullName</td>
                <td>@m.Email</td>
                <td>@(m.Role == "SupplierManager" ? "Manager" : "Staff")</td>
                <td>@if (m.IsLocked) { <span class="status status-gray">Disabled</span> } else { <span class="status status-green">Active</span> }</td>
                <td class="text-end">
                    @if (m.Role != "SupplierManager")
                    {
                        <form asp-action="Toggle" asp-route-id="@m.Id" method="post" class="d-inline">
                            <button class="btn btn-sm @(m.IsLocked ? "btn-outline-primary" : "btn-outline-danger")">@(m.IsLocked ? "Enable" : "Disable")</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</section>
