@model SupplierSystem.Web.ViewModels.ManualOrderViewModel
@{
    ViewData["Title"] = "New manual order";
    var products = (List<SupplierSystem.Web.Models.Product>)ViewBag.Products;
}
<a class="back-link" asp-action="Index">&larr; Orders</a>
<div class="page-header">
    <div>
        <div class="crumbs">Orders / <b>New manual order</b></div>
        <h1 class="page-title">New manual order</h1>
        <p class="page-sub">For a phone call or walk-in customer. It follows the same steps as any order, but nothing is sent to the Event Hub.</p>
    </div>
</div>

<form method="post">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="split">
        <section class="split-main">
            <div class="panel mb-0">
                <div class="panel-head"><h2>Items</h2></div>
                <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Item</th><th>Unit</th><th class="num">Price</th><th class="num">Available</th><th class="num" style="width:120px">Quantity</th></tr></thead>
                    <tbody>
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        var p = products.First(x => x.Id == Model.Items[i].ProductId);
                        <tr>
                            <td class="cell-title">@p.Name<input type="hidden" asp-for="Items[i].ProductId" /></td>
                            <td class="text-muted">@p.Unit</td>
                            <td class="num">@p.Price.ToString("N2")</td>
                            <td class="num">@(p.Inventory?.Available ?? 0)</td>
                            <td class="num"><input asp-for="Items[i].Quantity" type="number" min="0" class="form-control form-control-sm text-end" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            </div>
        </section>
        <aside class="split-side">
            <div class="panel panel-body mb-0">
                <h2 class="panel-title mb-3">Customer and delivery</h2>
                <div class="mb-3"><label asp-for="CustomerName" class="form-label"></label><input asp-for="CustomerName" class="form-control" /><span asp-validation-for="CustomerName" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="CustomerEmail" class="form-label"></label><input asp-for="CustomerEmail" class="form-control" /><span asp-validation-for="CustomerEmail" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control" /><span asp-validation-for="EventName" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="DeliveryAddress" class="form-label"></label><input asp-for="DeliveryAddress" class="form-control" /><span asp-validation-for="DeliveryAddress" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="DeliveryAtUtc" class="form-label"></label><input asp-for="DeliveryAtUtc" type="datetime-local" class="form-control" /><span asp-validation-for="DeliveryAtUtc" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" rows="3" class="form-control"></textarea></div>
                <button class="btn btn-primary w-100">Record order</button>
            </div>
        </aside>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
