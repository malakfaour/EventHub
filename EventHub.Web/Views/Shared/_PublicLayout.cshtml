@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isClient = User.IsInRole(Roles.Client);
    var isOrganizer = User.IsInRole(Roles.Organizer);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(bool on) => on ? "pub-link active" : "pub-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Event Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&amp;family=Instrument+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
</head>
<body class="theme-eventhub public">
    <header class="pub-nav">
        <div class="pub-wrap pub-nav-inner">
            <a class="brand" asp-controller="Discover" asp-action="Index">
                <span class="brand-mark"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M8 3v4M16 3v4M3 10h18"/><path d="M12 13.5l1 2 2 .3-1.5 1.4.4 2-1.9-1-1.9 1 .4-2-1.5-1.4 2-.3z"/></svg></span>
                <span class="brand-name pub-brand-name">Event Hub</span>
            </a>
            <nav class="pub-links" aria-label="Main">
                <a class="@Active(controller == "Discover")" asp-controller="Discover" asp-action="Index">Discover</a>
                @if (isClient)
                {
                    <a class="@Active(controller == "MyTickets")" asp-controller="MyTickets" asp-action="Index">My tickets</a>
                }
                @if (isOrganizer)
                {
                    <a class="pub-link" asp-controller="Events" asp-action="Index">My workspace</a>
                }
                <a class="@Active(controller == "Home" && action == "About")" asp-controller="Home" asp-action="About">About</a>
                <a class="@Active(controller == "Home" && action == "Contact")" asp-controller="Home" asp-action="Contact">Contact</a>
            </nav>
            <div class="pub-actions">
                @if (signedIn)
                {
                    <span class="pub-user" title="@User.Identity!.Name"><span class="avatar">@(User.Identity!.Name!.Length >= 2 ? User.Identity.Name[..2] : User.Identity.Name)</span><span class="pub-user-name">@User.Identity.Name</span></span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Log out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Sign up</a>
                }
            </div>
        </div>
    </header>
    <main role="main">
        <div class="pub-wrap">
            <partial name="_Alerts" />
        </div>
        @RenderBody()
    </main>
    <footer class="pub-footer">
        <div class="pub-wrap">
            <div class="footer-brand">
                <span class="pub-brand-name">Event Hub</span>
                <p>Running an event? <a asp-controller="Account" asp-action="Register">Create an organizer account</a> to sell tickets and order catering, decoration and sound.</p>
            </div>
            <nav class="footer-links" aria-label="Footer">
                <a asp-controller="Discover" asp-action="Index">Discover</a>
                <a asp-controller="Home" asp-action="About">About us</a>
                <a asp-controller="Home" asp-action="Contact">Contact</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </nav>
            <small class="footer-copy">&copy; @DateTime.UtcNow.Year Event Hub, Beirut</small>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
