@model EventHub.Web.ViewModels.ContactFormViewModel
@{
    ViewData["Title"] = "Contact us";
    Layout = "_PublicLayout";
    var sent = TempData["Sent"] is true;
}

<section class="pub-wrap contact-page">
    <div class="contact-intro">
        <h1>Talk to the Event Hub team.</h1>
        <p class="lead-text">We answer within one working day. If it is about a ticket you already bought, include the ticket code printed on your pass.</p>

        <dl class="contact-details">
            <div><dt>Email</dt><dd><a href="mailto:hello@eventhub.example">hello@eventhub.example</a></dd></div>
            <div><dt>Phone</dt><dd><a href="tel:+9611234567">+961 1 234 567</a></dd></div>
            <div><dt>Office</dt><dd>Mar Mikhael, Beirut</dd></div>
            <div><dt>Hours</dt><dd>Monday to Friday, 9:00 to 18:00</dd></div>
        </dl>

        <h2 class="faq-title">Quick answers</h2>
        <div class="faq">
            <details>
                <summary>Can I get a refund for my ticket?</summary>
                <p>Refunds depend on the organizer. Send us your ticket code and we will pass the request on. If an event is cancelled, every ticket is refunded.</p>
            </details>
            <details>
                <summary>Where are my tickets?</summary>
                <p>Sign in with your client account and open <a asp-controller="MyTickets" asp-action="Index">My tickets</a>. Each ticket has a QR code you can show at the door or print.</p>
            </details>
            <details>
                <summary>How do I become an organizer?</summary>
                <p><a asp-controller="Account" asp-action="Register">Create an account</a> and choose Organizer. You can create events, list what they need and order supplies right away.</p>
            </details>
            <details>
                <summary>How do suppliers join Event Hub?</summary>
                <p>Suppliers work in the Supplier System, where they manage their catalog, stock and orders. Choose "Selling as a supplier" in the form and tell us what you offer.</p>
            </details>
        </div>
    </div>

    <div class="contact-card">
        @if (sent)
        {
            <div class="sent-note" role="status">
                <h2>Message sent.</h2>
                <p>Thanks for writing. We reply to the email address you gave, usually within one working day.</p>
                <a class="btn btn-outline-secondary" asp-action="Contact">Write another message</a>
            </div>
        }
        else
        {
            <h2>Send us a message</h2>
            <form method="post" asp-action="Contact" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autocomplete="name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Topic" class="form-label"></label>
                        <select asp-for="Topic" class="form-select" asp-items="@(new SelectList(EventHub.Web.Models.ContactTopics.All))"></select>
                        <span asp-validation-for="Topic" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Message" class="form-label"></label>
                        <textarea asp-for="Message" class="form-control" rows="6" placeholder="Tell us what happened and we will get back to you."></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>
                    <div class="hp-field" aria-hidden="true">
                        <label for="Website">Leave this empty</label>
                        <input asp-for="Website" tabindex="-1" autocomplete="off" />
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary btn-lg">Send message</button>
                        <p class="form-note">We only use your email to reply to this message.</p>
                    </div>
                </div>
            </form>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
