@model List<EventHub.Web.ViewModels.AdminPurchaseRow>
@{ ViewData["Title"] = "Ticket sales"; }
<div class="page-header">
    <div>
        <div class="crumbs">Admin / <b>Ticket sales</b></div>
        <h1 class="page-title">Ticket sales</h1>
    </div>
</div>
<section class="panel">
    <div class="panel-head"><h2>All purchases</h2><span class="panel-note">@Model.Count purchases, @Model.Where(p => p.Status == PurchaseStatus.Paid).Sum(p => p.Total).ToString("N2") paid</span></div>
    @if (!Model.Any())
    {
        <div class="empty-state"><strong>No purchases yet</strong></div>
    }
    else
    {
        <div class="table-wrap">
        <table class="table table-hover">
            <thead><tr><th>Event</th><th>Client</th><th>Ticket</th><th class="num">Qty</th><th class="num">Total</th><th>Date</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td class="cell-title">@p.EventName</td>
                    <td>@p.Client</td>
                    <td>@p.TicketType</td>
                    <td class="num">@p.Quantity</td>
                    <td class="num fw-semibold">@p.Total.ToString("N2")</td>
                    <td class="text-muted">@p.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td><partial name="_StatusBadge" model="@p.Status.ToString()" /></td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
</section>
