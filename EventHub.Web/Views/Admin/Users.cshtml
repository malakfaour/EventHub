@model List<EventHub.Web.ViewModels.AdminUserRow>
@{ ViewData["Title"] = "Users"; }
<div class="page-header">
    <div>
        <div class="crumbs">Admin / <b>Users</b></div>
        <h1 class="page-title">Users</h1>
    </div>
</div>
<section class="panel">
    <div class="panel-head"><h2>All accounts</h2><span class="panel-note">@Model.Count users</span></div>
    <div class="table-wrap">
    <table class="table table-hover">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Organization</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td class="cell-title">@u.DisplayName</td>
                <td>@u.Email</td>
                <td>@u.Role</td>
                <td class="text-muted">@u.Organization</td>
                <td><partial name="_StatusBadge" model="@(u.IsLocked ? "Failed" : "Paid")" /> <span class="text-muted">@(u.IsLocked ? "Disabled" : "Active")</span></td>
                <td class="text-end">
                    @if (u.Role != "Admin")
                    {
                        <form asp-action="ToggleUser" asp-route-id="@u.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm @(u.IsLocked ? "btn-outline-primary" : "btn-outline-danger")">@(u.IsLocked ? "Enable" : "Disable")</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</section>
