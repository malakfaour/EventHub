@model List<EventHub.Web.Models.Event>
@{
    ViewData["Title"] = "Discover events";
    var search = ViewBag.Search as string;
    var type = ViewBag.Type as string;
}
<section class="pub-hero">
    <div class="pub-wrap">
        <span class="hero-kicker">Live events near you</span>
        <h1>Find your next<br /><span class="hero-accent">unforgettable</span> night.</h1>
        <p>Concerts, conferences, weddings and parties. Pick your event, grab your tickets in seconds.</p>
        <form method="get" class="hero-search" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
            <input name="search" value="@search" placeholder="Search by event or venue" aria-label="Search events" />
            @if (!string.IsNullOrEmpty(type)) { <input type="hidden" name="type" value="@type" /> }
            <button class="btn btn-primary">Search</button>
        </form>
    </div>
</section>

<section class="pub-wrap pub-section">
    <div class="type-chips">
        <a class="chip @(string.IsNullOrEmpty(type) ? "active" : "")" asp-action="Index" asp-route-search="@search">All</a>
        @foreach (var t in EventTypes.All)
        {
            <a class="chip @(type == t ? "active" : "")" asp-action="Index" asp-route-type="@t" asp-route-search="@search"><span aria-hidden="true">@EventTypes.Icon(t)</span> @t</a>
        }
    </div>

    <div class="section-head mb-3">
        <h2>@(string.IsNullOrEmpty(type) ? "Upcoming events" : type)</h2>
        <span class="text-muted small">@Model.Count event@(Model.Count == 1 ? "" : "s")</span>
    </div>

    @if (!Model.Any())
    {
        <div class="panel"><div class="empty-state"><strong>No events found</strong>Try another search or a different category.</div></div>
    }
    <div class="event-grid">
        @foreach (var ev in Model)
        {
            <partial name="_EventCard" model="ev" />
        }
    </div>
</section>
