@model ModerationItem
@{
    ViewData["Title"] = "Review event";
    var categories = (Dictionary<int, string>)ViewData["Categories"]!;
}
<a asp-action="Index" class="btn btn-link px-0">&larr; Back to queue</a>
<h1 class="h3 mb-3">@Model.Title</h1>

<div class="row g-4">
    <div class="col-lg-7">
        <dl class="row">
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
            <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@(categories.TryGetValue(Model.CategoryId, out var name) ? name : "#" + Model.CategoryId)</dd>
            <dt class="col-sm-3">Starts (UTC)</dt><dd class="col-sm-9">@Model.StartsAtUtc.ToString("yyyy-MM-dd HH:mm")</dd>
            <dt class="col-sm-3">Location</dt><dd class="col-sm-9">@Model.Location</dd>
            <dt class="col-sm-3">Capacity</dt><dd class="col-sm-9">@Model.Capacity</dd>
            <dt class="col-sm-3">Ticket price</dt><dd class="col-sm-9">@(Model.TicketPrice == 0 ? "Free" : Model.TicketPrice.ToString("C"))</dd>
            <dt class="col-sm-3">Organizer</dt><dd class="col-sm-9"><code>@Model.OrganizerId</code></dd>
            <dt class="col-sm-3">Event ID</dt><dd class="col-sm-9"><code>@Model.EventId</code></dd>
            <dt class="col-sm-3">AI risk</dt><dd class="col-sm-9">@(Model.AiRiskScore?.ToString() ?? "not available yet")</dd>
        </dl>
        <h2 class="h6">Description</h2>
        <p style="white-space: pre-wrap">@Model.Description</p>
    </div>

    <div class="col-lg-5">
        @if (Model.Status == ModerationStatus.Pending)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">Approve</h2>
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="featured" value="true" id="featured" />
                            <label class="form-check-label" for="featured">Feature on the home page</label>
                        </div>
                        <button type="submit" class="btn btn-success">Approve</button>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h2 class="h5">Reject</h2>
                    <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                        <div class="mb-3">
                            <label for="reasonCode" class="form-label">Reason</label>
                            <select name="reasonCode" id="reasonCode" class="form-select">
                                <option value="Spam">Spam</option>
                                <option value="Inappropriate">Inappropriate content</option>
                                <option value="Misleading">Misleading information</option>
                                <option value="Duplicate">Duplicate event</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="reasonText" class="form-label">Message to the organizer (required)</label>
                            <textarea name="reasonText" id="reasonText" class="form-control" rows="3" required maxlength="1000"></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger">Reject</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-secondary">
                Decided on @Model.DecidedAtUtc?.ToString("yyyy-MM-dd HH:mm") UTC.
                @if (!string.IsNullOrEmpty(Model.DecisionReason)) { <div class="mt-2">Reason: @Model.DecisionReason</div> }
            </div>
        }
    </div>
</div>
